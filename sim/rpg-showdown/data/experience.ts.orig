/**
 * Dados estáticos de experiência usados pelo RPG Showdown.
 *
 * Fonte: PokeAPI (pokemon.csv, pokemon_species.csv e experience.csv).
 * Recorte: espécies nacionais até #1025 e suas formas cadastradas.
 * Regras de progressão: geração 9.
 */

export const RPG_EXPERIENCE_GENERATION = 9;
export const LUCKY_EGG_MULTIPLIER = 1.5;

export type RPGGrowthRate =
	| 'erratic' |
	'fast' |
	'medium-fast' |
	'medium-slow' |
	'slow' |
	'fluctuating';

export interface RPGSpeciesExperienceData {
	baseExperience: number;
	growthRate: RPGGrowthRate;
}


export function getSpeciesExperience(speciesID: string): RPGSpeciesExperienceData | null {
	return SPECIES_EXPERIENCE[speciesID] || null;
}

export function getExperienceForLevel(growthRate: RPGGrowthRate, level: number): number {
	const safeLevel = Math.max(1, Math.min(100, Math.trunc(level)));
	return EXPERIENCE_BY_LEVEL[growthRate][safeLevel];
}

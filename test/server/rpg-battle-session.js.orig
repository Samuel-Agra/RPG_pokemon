'use strict';

const assert = require('assert').strict;
const { RPGLoginService } = require('../../dist/server/rpg-showdown');

function service(options = {}) {
	let byte = 0;
	let randomState = 0x12345678;
	return new RPGLoginService({
		masterCode: '14081998',
		random: () => {
			randomState = (1664525 * randomState + 1013904223) >>> 0;
			return randomState / 0x100000000;
		},
		randomBytes: size => Buffer.alloc(size, ++byte),
		...options,
	});
}

function character(login, name, password) {
	return login.createCharacter({
		characterName: name,
		playerName: name + ' real',
		avatar: 'lucas',
		password,
		initialMoney: 3000,
		starter: { species: 'Squirtle', gender: 'M' },
	});
}

function configuration(samuel, marina) {
	return {
		name: 'Chuva na Rota 1',
		format: 'doubles',
		opponentType: 'player',
		participants: [
			{
				id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id,
				displayName: 'Samuel', selectionLimit: 2, pokemon: [{ teamIndex: 0 }],
			},
			{
				id: 'marina', team: 'B', kind: 'player', characterId: marina.id,
				displayName: 'Marina', selectionLimit: 1, pokemon: [{ teamIndex: 0 }],
			},
		],
		conditions: {
			weather: { id: 'raindance', duration: 'temporary', turns: 5 },
			terrain: { id: 'electricterrain', duration: 'permanent', turns: 5 },
			startingTurn: 12,
			timeOfDay: 'night',
			isCave: true,
			isInWater: false,
			initialHazards: {
				A: { spikes: 1, stealthRock: false, toxicSpikes: 2 },
				B: { spikes: 3, stealthRock: true, toxicSpikes: 0 },
			},
		},
		rules: {
			canFlee: false,
			grantsExperience: false,
			allowSwitching: false,
			allowItems: false,
			playersChoosePokemon: false,
			wagerAmount: 500,
		},
	};
}

describe('RPG battle preparation sessions', () => {
	it('requires the master to configure and invite before starting', () => {
		const login = service();
		const samuel = character(login, 'Samuel', 'senha-samuel');
		const marina = character(login, 'Marina', 'senha-marina');
		const master = login.loginMaster('14081998');
		const samuelSession = login.loginPlayer(samuel.id, 'senha-samuel');
		const marinaSession = login.loginPlayer(marina.id, 'senha-marina');

		let battle = login.createBattleSession(master.token, { name: 'Rota 1' });
		assert.equal(battle.status, 'draft');
		assert.equal(battle.conditions.startingTurn, 1);
		assert.throws(() => login.startBattleSession(master.token, battle.id), /not ready/);

		battle = login.updateBattleSession(master.token, battle.id, configuration(samuel, marina));
		assert.equal(battle.format, 'doubles');
		assert.equal(battle.participants[0].pokemon[0].set, undefined);
		assert.equal(login.listBattleSessions(samuelSession.token).length, 0);
		assert.throws(() => login.getBattleSession(samuelSession.token, battle.id), /cannot access/);
		battle = login.inviteBattleSession(master.token, battle.id);
		assert.equal(battle.status, 'inviting');
		assert.deepEqual(battle.invitations.map(item => item.response), ['pending', 'pending']);
		assert.equal(login.listBattleSessions(samuelSession.token).length, 1);

		battle = login.respondToBattleInvitation(samuelSession.token, battle.id, 'accepted');
		assert.equal(battle.status, 'inviting');
		battle = login.respondToBattleInvitation(marinaSession.token, battle.id, 'accepted');
		assert.equal(battle.status, 'ready');

		const result = login.startBattleSession(master.token, battle.id);
		assert.equal(result.session.status, 'started');
		assert.equal(result.launch.format, 'doubles');
		assert.deepEqual(result.launch.controllers, [
			{ participantId: 'samuel', controller: 'player', characterId: samuel.id },
			{ participantId: 'marina', controller: 'player', characterId: marina.id },
		]);
		assert.equal(result.launch.rpg.battleType, 'trainer');
		assert.equal(result.launch.rpg.weather, 'raindance');
		assert.equal(result.launch.rpg.weatherDuration, 5);
		assert.equal(result.launch.rpg.terrain, 'electricterrain');
		assert.equal(result.launch.rpg.terrainDuration, undefined);
		assert.equal(result.launch.rpg.modeRules.trainer.allowFlee, false);
		assert.equal(result.launch.rpg.modeRules.trainer.allowBattleItems, false);
		assert.equal(result.launch.rpg.modeRules.trainer.experienceMultiplier, 0);
		assert.deepEqual(result.launch.captureContext, {
			turnNumber: 12, isNight: true, isCave: true, isInWater: false,
		});
		assert.equal(result.launch.allowSwitching, false);
		assert.deepEqual(result.launch.initialHazards, {
			A: { spikes: 1, stealthRock: false, toxicSpikes: 2 },
			B: { spikes: 3, stealthRock: true, toxicSpikes: 0 },
		});
		assert.equal(result.session.wager.status, 'reserved');
		assert.equal(result.session.wager.stakes.length, 2);
		assert.equal(login.getCharacter(master.token, samuel.id).money, 2500);
		assert.equal(login.getCharacter(master.token, marina.id).money, 2500);
		const second = structuredClone(result.session);
		second.id = 'secondreadybattle';
		second.status = 'ready';
		delete second.startedAt;
		delete second.wager;
		login.battleSessions.repository.create(second);
		assert.throws(() => login.startBattleSession(master.token, second.id), /already active/);
	});

	it('assigns every non-player participant to the master controller', () => {
		const login = service();
		const samuel = character(login, 'Samuel', 'senha-samuel');
		const master = login.loginMaster('14081998');
		const player = login.loginPlayer(samuel.id, 'senha-samuel');
		let battle = login.createBattleSession(master.token);
		battle = login.updateBattleSession(master.token, battle.id, {
			format: 'singles', opponentType: 'wild',
			participants: [
				{
					id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id,
					displayName: 'Samuel', selectionLimit: 1, pokemon: [{ teamIndex: 0 }],
				},
				{
					id: 'wild-b', team: 'B', kind: 'wild', displayName: 'Pidgey selvagem',
					selectionLimit: 1, pokemon: [{ set: { name: 'Pidgey', species: 'Pidgey', level: 5, moves: ['tackle'] } }],
				},
			],
		});
		battle = login.inviteBattleSession(master.token, battle.id);
		battle = login.respondToBattleInvitation(player.token, battle.id, 'accepted');
		const result = login.startBattleSession(master.token, battle.id);
		assert.deepEqual(result.launch.controllers, [
			{ participantId: 'samuel', controller: 'player', characterId: samuel.id },
			{ participantId: 'wildb', controller: 'master' },
		]);
	});
	it('assigns IV 0 to wild and horde encounters and IV 31 to Raid and Boss opponents', () => {
		const expected = { singles: 0, raid: 31, boss: 31 };
		for (const [format, iv] of Object.entries(expected)) {
			const login = service();
			const samuel = character(login, 'Samuel', 'senha-samuel');
			const master = login.loginMaster('14081998');
			let battle = login.createBattleSession(master.token);
			const species = format === 'boss' ? 'Mewtwo' : 'Pidgey';
			battle = login.updateBattleSession(master.token, battle.id, {
				format, opponentType: 'wild', participants: [
					{ id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id, displayName: 'Samuel', selectionLimit: 1, pokemon: [{ teamIndex: 0 }] },
					{ id: 'wild', team: 'B', kind: 'wild', displayName: species, selectionLimit: 1, pokemon: [{ set: { species, level: format === 'boss' ? 150 : 5, moves: ['tackle'] } }] },
				],
			});
			battle = login.inviteBattleSession(master.token, battle.id);
			assert.deepEqual(battle.participants[1].pokemon[0].set.ivs, { hp: iv, atk: iv, def: iv, spa: iv, spd: iv, spe: iv });
		}
		const login = service();
		const samuel = character(login, 'Samuel', 'senha-samuel');
		const master = login.loginMaster('14081998');
		let battle = login.createBattleSession(master.token);
		battle = login.updateBattleSession(master.token, battle.id, {
			format: 'singles', opponentType: 'horde', participants: [
				{ id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id, displayName: 'Samuel', selectionLimit: 1, pokemon: [{ teamIndex: 0 }] },
				{ id: 'horde', team: 'B', kind: 'horde', displayName: 'Horda', selectionLimit: 1, pokemon: [{ set: { species: 'Caterpie', level: 5, moves: ['tackle'] } }] },
			],
		});
		battle = login.inviteBattleSession(master.token, battle.id);
		assert.deepEqual(battle.participants[1].pokemon[0].set.ivs, { hp: 0, atk: 0, def: 0, spa: 0, spd: 0, spe: 0 });
	});

	it('rolls shiny wild encounters and honors guaranteed or disabled creation modes', () => {
		function controlled(random, format, kind, modes, species = 'Caterpie', level = 5) {
			const login = service({ random });
			const samuel = character(login, 'Samuel', 'senha-samuel');
			const master = login.loginMaster('14081998');
			let battle = login.createBattleSession(master.token);
			battle = login.updateBattleSession(master.token, battle.id, {
				format, opponentType: kind === 'horde' ? 'horde' : 'wild',
				participants: [
					{
						id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id,
						displayName: 'Samuel', selectionLimit: 1, pokemon: [{ teamIndex: 0 }],
					},
					{
						id: 'controlled', team: 'B', kind, displayName: species,
						selectionLimit: modes.length,
						pokemon: modes.map(shinyMode => ({ set: { species, level }, shinyMode })),
					},
				],
			});
			return battle.participants[1].pokemon;
		}

		assert.equal(controlled(() => 0, 'singles', 'wild', ['random'])[0].set.shiny, true);
		assert.equal(controlled(() => 0.5, 'singles', 'wild', ['random'])[0].set.shiny, false);
		assert.equal(controlled(() => 0, 'boss', 'wild', ['disabled'], 'Mewtwo', 150)[0].set.shiny, false);
		assert.equal(controlled(() => 0.5, 'boss', 'wild', ['guaranteed'], 'Mewtwo', 150)[0].set.shiny, true);
		const horde = controlled(() => 0, 'singles', 'horde', ['disabled', 'guaranteed', 'disabled']);
		assert.equal(horde.filter(choice => choice.set.shiny).length, 1);
	});
	it('restricts preparation to the master and resets invitations after edits', () => {
		const login = service();
		const samuel = character(login, 'Samuel', 'senha-samuel');
		const marina = character(login, 'Marina', 'senha-marina');
		const master = login.loginMaster('14081998');
		const player = login.loginPlayer(samuel.id, 'senha-samuel');
		let battle = login.createBattleSession(master.token);

		assert.throws(() => login.createBattleSession(player.token), /master session required/);
		battle = login.updateBattleSession(master.token, battle.id, configuration(samuel, marina));
		battle = login.inviteBattleSession(master.token, battle.id);
		assert.throws(
			() => login.respondToBattleInvitation(master.token, battle.id, 'declined'),
			/player session required/
		);
		battle = login.respondToBattleInvitation(player.token, battle.id, 'declined');
		assert.equal(battle.status, 'declined');
		battle = login.updateBattleSession(master.token, battle.id, { name: 'Nova regra' });
		assert.equal(battle.status, 'draft');
		assert.deepEqual(battle.invitations, []);
	});
	it('derives capture conditions from the selected battle scene', () => {
		const login = service();
		const master = login.loginMaster('14081998');
		let battle = login.createBattleSession(master.token);
		assert.equal(battle.conditions.sceneId, 'meadow');
		assert.equal(battle.conditions.isCave, false);
		assert.equal(battle.conditions.isInWater, false);

		battle = login.updateBattleSession(master.token, battle.id, {
			conditions: { sceneId: 'dampcave', isCave: false, isInWater: true },
		});
		assert.equal(battle.conditions.sceneId, 'dampcave');
		assert.equal(battle.conditions.isCave, true);
		assert.equal(battle.conditions.isInWater, false);

		battle = login.updateBattleSession(master.token, battle.id, {
			conditions: { sceneId: 'orassea' },
		});
		assert.equal(battle.conditions.isCave, false);
		assert.equal(battle.conditions.isInWater, true);
		assert.throws(
			() => login.updateBattleSession(master.token, battle.id, { conditions: { sceneId: 'missing' } }),
			/Invalid RPG battle scene/
		);
	});	it('validates hazard layers and restricts wagers to Player or NPC battles', () => {
		const login = service();
		const master = login.loginMaster('14081998');
		let battle = login.createBattleSession(master.token);
		assert.throws(() => login.updateBattleSession(master.token, battle.id, {
			conditions: { initialHazards: { A: { spikes: 4 } } },
		}), /A Spikes/);
		assert.throws(() => login.updateBattleSession(master.token, battle.id, {
			conditions: { initialHazards: { B: { toxicSpikes: 3 } } },
		}), /B Toxic Spikes/);
		const samuel = character(login, 'Samuel', 'senha-samuel');
		battle = login.updateBattleSession(master.token, battle.id, {
			format: 'singles', opponentType: 'wild',
			participants: [
				{ id: 'samuel', team: 'A', kind: 'player', characterId: samuel.id, displayName: 'Samuel', selectionLimit: 1, pokemon: [{ teamIndex: 0 }] },
				{ id: 'wild', team: 'B', kind: 'wild', displayName: 'Pidgey', selectionLimit: 1, pokemon: [{ set: { species: 'Pidgey', level: 5, moves: ['tackle'] } }] },
			],
			rules: { wagerAmount: 100 },
		});
		assert.equal(battle.rules.wagerAmount, 100);
		assert.throws(() => login.inviteBattleSession(master.token, battle.id), /only against a Player or NPC/);
	});

	it('settles a Player wager once and rolls back safely when funds are insufficient', () => {
		const login = service();
		const samuel = character(login, 'Samuel', 'senha-samuel');
		const marina = character(login, 'Marina', 'senha-marina');
		const master = login.loginMaster('14081998');
		const samuelSession = login.loginPlayer(samuel.id, 'senha-samuel');
		const marinaSession = login.loginPlayer(marina.id, 'senha-marina');
		let battle = login.createBattleSession(master.token);
		battle = login.updateBattleSession(master.token, battle.id, configuration(samuel, marina));
		battle = login.inviteBattleSession(master.token, battle.id);
		login.respondToBattleInvitation(samuelSession.token, battle.id, 'accepted');
		login.respondToBattleInvitation(marinaSession.token, battle.id, 'accepted');
		login.startBattleSession(master.token, battle.id);
		const result = { outcome: 'win', winnerSide: 'p1', rewards: [], pokemon: [] };
		login.completeBattleSession(battle.id, result);
		login.completeBattleSession(battle.id, result);
		assert.equal(login.getCharacter(master.token, samuel.id).money, 3500);
		assert.equal(login.getCharacter(master.token, marina.id).money, 2500);
		assert.equal(login.getBattleSession(master.token, battle.id).wager.status, 'settled');

		const poorLogin = service();
		const poorA = character(poorLogin, 'Pobre A', 'senha-a');
		const poorB = character(poorLogin, 'Pobre B', 'senha-b');
		const poorMaster = poorLogin.loginMaster('14081998');
		const poorASession = poorLogin.loginPlayer(poorA.id, 'senha-a');
		const poorBSession = poorLogin.loginPlayer(poorB.id, 'senha-b');
		let poorBattle = poorLogin.createBattleSession(poorMaster.token);
		const poorConfig = configuration(poorA, poorB);
		poorConfig.rules.wagerAmount = 4000;
		poorBattle = poorLogin.updateBattleSession(poorMaster.token, poorBattle.id, poorConfig);
		poorBattle = poorLogin.inviteBattleSession(poorMaster.token, poorBattle.id);
		poorLogin.respondToBattleInvitation(poorASession.token, poorBattle.id, 'accepted');
		poorLogin.respondToBattleInvitation(poorBSession.token, poorBattle.id, 'accepted');
		assert.throws(() => poorLogin.startBattleSession(poorMaster.token, poorBattle.id), /não possui/);
		assert.equal(poorLogin.getBattleSession(poorMaster.token, poorBattle.id).status, 'ready');
		assert.equal(poorLogin.getCharacter(poorMaster.token, poorA.id).money, 3000);
		assert.equal(poorLogin.getCharacter(poorMaster.token, poorB.id).money, 3000);
	});
});

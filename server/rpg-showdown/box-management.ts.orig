import { Dex } from '../../sim/dex';
import { toID } from '../../sim/dex-data';
import type { PokemonSet } from '../../sim/teams';
import {
	RPGBoxSystem,
	RPGItems,
	getExperienceForLevel,
	getSpeciesExperience,
	RPGTeamBuilderSystem,
	getRPGPokemonSizeClass,
	type RPGBoxCapacity,
	type RPGBoxLocation,
	type RPGBoxState,
	type RPGCapturedPokemon,
	type RPGPokemonState,
	type RPGStoredPokemon,
} from '../../sim/rpg-showdown';

export interface RPGItemEvolutionOption {
	pokemonId: string;
	fromSpecies: string;
	toSpecies: string;
	fromSpriteId: string;
	toSpriteId: string;
	fromSizeClass: string;
	toSizeClass: string;
}

export interface RPGItemEvolutionResult extends RPGItemEvolutionOption {
	level: number;
}
export interface RPGTechnicalMachineTarget {
	pokemonId: string;
	name: string;
	species: string;
	level: number;
	moves: RPGBoxPokemonView['moves'];
	hasOpenMoveSlot: boolean;
	eligible?: boolean;
	disabledReason?: string;
}
export interface RPGTechnicalMachineResult {
	pokemonId: string;
	pokemonName: string;
	species: string;
	moveId: string;
	moveName: string;
	forgottenMoveId?: string;
	forgottenMoveName?: string;
	moves: RPGBoxPokemonView['moves'];
}
export const RPG_BOX_MANAGEMENT_VERSION = 1;
export type RPGBoxTrainingState = 'none' | 'ev' | 'roleplay';
export type RPGTeamBuilderStat = 'hp' | 'atk' | 'def' | 'spa' | 'spd' | 'spe';
export interface RPGEVTrainingJob {
	stat: RPGTeamBuilderStat;
	amount: 4;
	cost: 200;
	startedAt: number;
	completesAt: number;
}
export interface RPGEVTrainingResult {
	fromStat: RPGTeamBuilderStat;
	toStat: RPGTeamBuilderStat;
	amount: number;
	steps: number;
	cost: number;
	roleplayDurationMs: number;
}
export interface RPGEVDistributionTrainingResult {
	values: Record<RPGTeamBuilderStat, number>;
	changes: Record<RPGTeamBuilderStat, number>;
	amount: number;
	steps: number;
	cost: number;
	roleplayDurationMs: number;
}
export type RPGBoxStatusFilter = 'all' | 'healthy' | 'fainted' | 'statused' | string;
export type RPGBoxFavoriteMarker = 'star' | 'heart' | 'magnifier' | 'ribbon' |
	'flag-blue' | 'flag-red' | 'flag-yellow' | 'flag-green' | 'flag-black' | 'flag-white' | 'thumbs-up';

const RPG_BOX_FAVORITE_MARKERS: readonly RPGBoxFavoriteMarker[] = [
	'star', 'heart', 'magnifier', 'ribbon', 'flag-blue', 'flag-red', 'flag-yellow',
	'flag-green', 'flag-black', 'flag-white', 'thumbs-up',
];

export interface RPGBoxPokemonMetadata {
	favorite?: boolean;
	favoriteMarker?: RPGBoxFavoriteMarker;
	companion?: boolean;
	training?: RPGBoxTrainingState;
	lastBattleAt?: number;
	ot?: string;
	evTraining?: RPGEVTrainingJob;
}

export interface RPGManagedStoredPokemon extends RPGStoredPokemon {
	metadata?: RPGBoxPokemonMetadata;
}

export interface RPGBoxCharacterData {
	id: string;
	characterName: string;
	team: PokemonSet[];
	box: RPGBoxState;
}

export interface RPGBoxQuery {
	search?: string;
	type?: string;
	status?: RPGBoxStatusFilter;
	boxIndex?: number;
}

export interface RPGBoxPokemonView {
	pokemonId: string;
	location: RPGBoxLocation;
	name: string;
	species: string;
	speciesId: string;
	pokedexNumber: number;
	types: string[];
	spriteId: string;
	level: number;
	experience: number;
	hp: number;
	maxHP: number;
	status: string;
	fainted: boolean;
	item: string;
	nature: string;
	ability: string;
	gender: string;
	shiny: boolean;
	moves: {
		id: string; name: string; type: string; category: string;
		pp: number; maxPP: number;
	}[];
	evs: PokemonSet['evs'];
	ivs: PokemonSet['ivs'];
	metadata: RPGBoxPokemonMetadata & {
		favorite: boolean;
		companion: boolean;
		training: RPGBoxTrainingState;
	};
	indicators: string[];
	actions: {
		move: boolean;
		release: boolean;
		center: boolean;
		training: boolean;
		favorite: boolean;
		teamBuilder: boolean;
	};
}

export interface RPGBoxManagementView {
	version: number;
	ownerId: string;
	revision: number;
	tier: RPGBoxState['tier'];
	capacity: RPGBoxCapacity;
	team: RPGBoxPokemonView[];
	boxes: {
		index: number; name: string; used: number; capacity: number;
		pokemon: RPGBoxPokemonView[];
	}[];
	results: RPGBoxPokemonView[];
}

export interface RPGBoxMoveInput {
	pokemonId: string;
	destination: RPGBoxLocation;
	expectedRevision: number;
}

export interface RPGBoxMasterEdit {
	hp?: number;
	pp?: number[];
	status?: string;
	experience?: number;
	item?: string;
	ot?: string;
	species?: string;
}

export class RPGBoxManagement {
	static view(character: RPGBoxCharacterData, query: RPGBoxQuery = {}): RPGBoxManagementView {
		const all = this.entries(character);
		const views = all.map(stored => this.pokemonView(stored));
		const team = views.filter(view => view.location.destination === 'party');
		const boxes = character.box.boxes.map(box => {
			const pokemon = views.filter(view =>
				view.location.destination === 'box' && view.location.boxIndex === box.index
			);
			return { index: box.index, name: box.name, used: pokemon.length, capacity: box.slots.length, pokemon };
		});
		const search = toID(query.search || '');
		const type = toID(query.type || '');
		const status = toID(query.status || 'all');
		if (query.boxIndex !== undefined && (!Number.isSafeInteger(query.boxIndex) ||
			query.boxIndex < 0 || query.boxIndex >= character.box.boxes.length)) {
			throw new Error('Invalid RPG Box index');
		}
		const results = views.filter(view => {
			const numericSearch = /^\d+$/.test((query.search || '').trim()) &&
				Number(query.search) === view.pokedexNumber;
			if (query.boxIndex !== undefined &&
				(view.location.destination !== 'box' || view.location.boxIndex !== query.boxIndex)) return false;
			if (search && !numericSearch && ![view.name, view.species, String(view.pokedexNumber)]
				.some(value => toID(value).includes(search))) return false;
			if (type && type !== 'all' && !view.types.some(value => toID(value) === type)) return false;
			if (status === 'healthy' && (view.fainted || !!view.status)) return false;
			if (status === 'alive' && view.fainted) return false;
			if (status === 'fainted' && !view.fainted) return false;
			if (status === 'statused' && !view.status) return false;
			if (status === 'poisoned' && !['psn', 'tox'].includes(view.status)) return false;
			if (!['', 'all', 'healthy', 'alive', 'fainted', 'statused', 'poisoned'].includes(status) &&
				toID(view.status) !== status) {
				return false;
			}
			return true;
		});
		return {
			version: RPG_BOX_MANAGEMENT_VERSION, ownerId: character.id,
			revision: character.box.revision, tier: character.box.tier,
			capacity: RPGBoxSystem.getCapacity(character.box), team, boxes, results,
		};
	}

	static rename(character: RPGBoxCharacterData, boxIndex: number, name: string, expectedRevision: number): void {
		this.revision(character, expectedRevision);
		if (!Number.isSafeInteger(boxIndex) || boxIndex < 0 || boxIndex >= character.box.boxes.length) {
			throw new Error('Invalid RPG Box index');
		}
		const normalized = typeof name === 'string' ? name.trim() : '';
		if (!normalized || normalized.length > 30) {
			throw new Error('RPG Box name must contain between 1 and 30 characters');
		}
		character.box.boxes[boxIndex].name = normalized;
		this.commit(character);
	}

	static move(character: RPGBoxCharacterData, input: RPGBoxMoveInput): void {
		this.revision(character, input.expectedRevision);
		const source = this.location(character.box, input.pokemonId);
		if (!source) throw new Error('Unknown RPG Box Pokemon');
		this.validateDestination(character.box, input.destination);
		if (this.sameLocation(source, input.destination)) return;
		const destinationEntry = this.entryAt(character.box, input.destination);
		if (destinationEntry) {
			const sourceEntry = this.entryAt(character.box, source)!;
			this.setEntry(character.box, source, destinationEntry);
			this.setEntry(character.box, input.destination, sourceEntry);
			this.commit(character);
			return;
		}
		const entry = this.remove(character.box, source);
		try {
			if (input.destination.destination === 'party') {
				if (character.box.party.length >= 6) throw new Error('RPG party is full');
				character.box.party.splice(
					Math.min(input.destination.position, character.box.party.length), 0, entry
				);
			} else {
				const target = character.box.boxes[input.destination.boxIndex].slots[input.destination.slot];
				if (target) throw new Error('RPG Box destination slot is occupied');
				character.box.boxes[input.destination.boxIndex].slots[input.destination.slot] = entry;
			}
		} catch (error) {
			this.restore(character.box, source, entry);
			throw error;
		}
		this.commit(character);
	}

	static metadata(
		character: RPGBoxCharacterData, pokemonId: string,
		metadata: Partial<RPGBoxPokemonMetadata>, expectedRevision: number
	): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		if (metadata.training !== undefined && !['none', 'ev', 'roleplay'].includes(metadata.training)) {
			throw new Error('Invalid RPG Pokemon training state');
		}
		const next = { ...(entry.metadata || {}) };
		if (metadata.favorite !== undefined) next.favorite = !!metadata.favorite;
		if (metadata.favoriteMarker !== undefined) {
			if (!RPG_BOX_FAVORITE_MARKERS.includes(metadata.favoriteMarker)) {
				throw new Error('Invalid RPG Pokemon favorite marker');
			}
			next.favorite = true;
			next.favoriteMarker = metadata.favoriteMarker;
		}
		if (metadata.favorite === false) delete next.favoriteMarker;
		if (metadata.companion !== undefined) next.companion = !!metadata.companion;
		if (metadata.training !== undefined) next.training = metadata.training;
		if (metadata.ot !== undefined) next.ot = this.text(metadata.ot, 'OT', 50);
		if (metadata.lastBattleAt !== undefined) {
			if (!Number.isSafeInteger(metadata.lastBattleAt) || metadata.lastBattleAt < 0) {
				throw new Error('Invalid RPG Pokemon last battle date');
			}
			next.lastBattleAt = metadata.lastBattleAt;
		}
		entry.metadata = next;
		this.commit(character);
	}

	static heldItem(character: RPGBoxCharacterData, pokemonId: string): {
		pokemonId: string; pokemonName: string; species: string; itemId: string;
	} {
		const entry = this.requireEntry(character.box, pokemonId);
		const view = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		return {
			pokemonId, pokemonName: view.name, species: view.species, itemId: toID(entry.pokemon.item || ''),
		};
	}

	static setHeldItem(
		character: RPGBoxCharacterData, pokemonId: string, itemId: string | undefined, expectedRevision: number
	): { pokemonId: string; pokemonName: string; previousItemId: string; itemId: string } {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		const previousItemId = toID(entry.pokemon.item || '');
		const normalized = toID(itemId || '');
		if (normalized) {
			const item = RPGItems.require(normalized);
			if (item.category !== 'held') throw new Error('Only a held item can be equipped');
			entry.pokemon.item = item.name;
		} else {
			entry.pokemon.item = '';
		}
		this.commit(character);
		const view = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		return { pokemonId, pokemonName: view.name, previousItemId, itemId: normalized };
	}

	static itemTarget(character: RPGBoxCharacterData, pokemonId: string): {
		pokemonId: string; state: RPGPokemonState; maxHP: number; maxPP: number[];
	} {
		const entry = this.requireEntry(character.box, pokemonId);
		const view = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		return {
			pokemonId, state: structuredClone(entry.pokemon.rpg), maxHP: view.maxHP,
			maxPP: view.moves.map(move => move.maxPP),
		};
	}

	static applyItemState(
		character: RPGBoxCharacterData, pokemonId: string, state: RPGPokemonState, expectedRevision: number
	): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		entry.pokemon.rpg = structuredClone(state);
		this.commit(character);
	}
	static itemEvolutionOptions(
		character: RPGBoxCharacterData, pokemonId: string, itemId: string
	): RPGItemEvolutionOption[] {
		const entry = this.requireEntry(character.box, pokemonId);
		const dex = Dex.mod('gen9');
		const source = dex.species.get(entry.pokemon.species);
		const normalizedItem = toID(itemId);
		return (source.evos || []).flatMap(evolution => {
			const target = dex.species.get(evolution);
			const requiredItem = toID(target.evoItem || target.evoCondition || '');
			if (!target.exists || target.evoType !== 'useItem' || requiredItem !== normalizedItem ||
				target.isNonstandard === 'CAP' || target.isNonstandard === 'Future') return [];
			if ((target.gender === 'M' || target.gender === 'F') && entry.pokemon.gender !== target.gender) return [];
			return [{
				pokemonId, fromSpecies: source.name, toSpecies: target.name,
				fromSpriteId: source.id, toSpriteId: target.id,
				fromSizeClass: getRPGPokemonSizeClass(source.heightm),
				toSizeClass: getRPGPokemonSizeClass(target.heightm),
			}];
		});
	}

	static evolveWithItem(
		character: RPGBoxCharacterData, pokemonId: string, itemId: string,
		toSpecies: string, expectedRevision: number
	): RPGItemEvolutionResult {
		this.revision(character, expectedRevision);
		const option = this.itemEvolutionOptions(character, pokemonId, itemId)
			.find(candidate => candidate.toSpriteId === toID(toSpecies));
		if (!option) throw new Error('Este item não pode evoluir este Pokémon para a espécie escolhida');
		const entry = this.requireEntry(character.box, pokemonId);
		const before = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		const dex = Dex.mod('gen9');
		const source = dex.species.get(entry.pokemon.species);
		const target = dex.species.get(option.toSpecies);
		const defaultName = toID(entry.pokemon.name || source.name) === source.id;
		const sourceAbilitySlot = Object.entries(source.abilities)
			.find(([, ability]) => toID(ability) === toID(entry.pokemon.ability))?.[0] || '0';
		entry.pokemon.species = target.name;
		if (defaultName) entry.pokemon.name = target.name;
		entry.pokemon.ability = target.abilities[sourceAbilitySlot as keyof typeof target.abilities] || target.abilities[0];
		const after = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		entry.pokemon.rpg.hp = before.fainted ? 0 : Math.min(after.maxHP, before.hp + after.maxHP - before.maxHP);
		this.commit(character);
		return { ...option, level: entry.pokemon.level };
	}
	static technicalMachineTarget(
		character: RPGBoxCharacterData, pokemonId: string, moveId: string
	): RPGTechnicalMachineTarget | undefined {
		const entry = this.requireEntry(character.box, pokemonId);
		const dex = Dex.mod('gen9');
		const move = dex.moves.get(moveId);
		if (!move.exists) throw new Error('Movimento de TM desconhecido');
		if (entry.pokemon.moves.some(known => toID(known) === move.id)) return;
		const species = dex.species.get(entry.pokemon.species);
		const compatible = dex.species.getFullLearnset(species.id).some(data =>
			data.learnset[move.id]?.some(source => source.startsWith('9M'))
		);
		if (!compatible) return;
		const view = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		return {
			pokemonId, name: view.name, species: view.species, level: view.level,
			moves: structuredClone(view.moves), hasOpenMoveSlot: view.moves.length < 4,
		};
	}

	static teachTechnicalMachine(
		character: RPGBoxCharacterData, pokemonId: string, moveId: string,
		forgottenMoveId: string | undefined, expectedRevision: number
	): RPGTechnicalMachineResult {
		this.revision(character, expectedRevision);
		const target = this.technicalMachineTarget(character, pokemonId, moveId);
		if (!target) throw new Error('Este Pokémon não pode aprender esta TM');
		const entry = this.requireEntry(character.box, pokemonId);
		const dex = Dex.mod('gen9');
		const move = dex.moves.get(moveId);
		const nextMoves = [...entry.pokemon.moves];
		const nextPP = nextMoves.map((known, index) => {
			const knownMove = dex.moves.get(known);
			return Math.max(0, Math.min(knownMove.pp || 1, entry.pokemon.rpg.pp?.[index] ?? knownMove.pp ?? 1));
		});
		let forgottenMove;
		if (nextMoves.length >= 4) {
			const replacement = toID(forgottenMoveId || '');
			const index = nextMoves.findIndex(known => toID(known) === replacement);
			if (index < 0) throw new Error('Escolha um dos quatro movimentos para substituir');
			forgottenMove = dex.moves.get(nextMoves[index]);
			nextMoves[index] = move.name;
			nextPP[index] = move.pp || 1;
		} else {
			if (forgottenMoveId) throw new Error('Não é necessário esquecer um movimento');
			nextMoves.push(move.name);
			nextPP.push(move.pp || 1);
		}
		entry.pokemon.moves = nextMoves;
		entry.pokemon.rpg.pp = nextPP;
		this.commit(character);
		const view = this.pokemonView({ entry, location: this.location(character.box, pokemonId)! });
		return {
			pokemonId, pokemonName: view.name, species: view.species,
			moveId: move.id, moveName: move.name,
			...(forgottenMove?.exists ? {
				forgottenMoveId: forgottenMove.id, forgottenMoveName: forgottenMove.name,
			} : {}),
			moves: structuredClone(view.moves),
		};
	}

	static healAtCenter(character: RPGBoxCharacterData, pokemonId: string, expectedRevision: number): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		const view = this.pokemonView({
			entry, location: this.location(character.box, pokemonId)!,
		});
		entry.pokemon.rpg = {
			...entry.pokemon.rpg, hp: view.maxHP, pp: view.moves.map(move => move.maxPP),
			status: '', sleepTurns: undefined,
		};
		this.commit(character);
	}

	static release(character: RPGBoxCharacterData, pokemonId: string, expectedRevision: number): RPGStoredPokemon {
		this.revision(character, expectedRevision);
		const location = this.location(character.box, pokemonId);
		if (!location) throw new Error('Unknown RPG Box Pokemon');
		const released = this.remove(character.box, location);
		character.box.placements = character.box.placements.filter(entry => entry.pokemonId !== pokemonId);
		this.commit(character);
		return structuredClone(released);
	}


	static pokemonSet(character: RPGBoxCharacterData, pokemonId: string): PokemonSet {
		return this.capturedToSet(this.requireEntry(character.box, pokemonId).pokemon);
	}

	static playerTeamBuilder(
		character: RPGBoxCharacterData, pokemonId: string, candidate: PokemonSet, expectedRevision: number
	): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		const current = this.capturedToSet(entry.pokemon);
		for (const field of ['species', 'level', 'gender', 'nature', 'item', 'ability'] as const) {
			if (candidate[field] !== current[field]) throw new Error('RPG Team Builder field is locked: ' + field);
		}
		if (!!candidate.shiny !== !!current.shiny) throw new Error('RPG Team Builder field is locked: shiny');
		if (JSON.stringify(candidate.evs) !== JSON.stringify(current.evs)) {
			throw new Error('EVs só podem ser alterados pelo Centro de Treinamento');
		}
		if (JSON.stringify(candidate.ivs) !== JSON.stringify(current.ivs)) {
			throw new Error('IVs só podem ser alterados usando vitaminas');
		}
		const currentMoves = current.moves.map(toID);
		const candidateMoves = candidate.moves.map(toID);
		if (JSON.stringify(candidateMoves) !== JSON.stringify(currentMoves)) {
			throw new Error('RPG Team Builder field is locked: moves');
		}
		const dex = Dex.mod('gen9');
		const species = dex.species.get(current.species);
		const edited = RPGTeamBuilderSystem.apply([current], [candidate], {
			editable: { moves: false, ability: false },
			minLevel: current.level, maxLevel: current.level, maxMoves: 4,
			maxEVPerStat: 252, maxTotalEVs: 508, maxIVPerStat: 31,
			allowedMoves: currentMoves, allowedAbilities: [current.ability],
		})[0];
		const previousPP = new Map(current.moves.map((move, index) => [
			toID(move), current.rpg?.pp?.[index] ?? dex.moves.get(move).pp ?? 1,
		]));
		edited.name = this.text(candidate.name || species.name, 'Pokemon nickname', 30);
		edited.rpg = structuredClone(current.rpg || {});
		edited.rpg.pp = edited.moves.map(move => {
			const maximum = dex.moves.get(move).pp || 1;
			return Math.max(0, Math.min(maximum, previousPP.get(toID(move)) ?? maximum));
		});
		entry.pokemon = this.setToCaptured(edited);
		this.commit(character);
	}

	static trainEVs(
		character: RPGBoxCharacterData & { money: number }, pokemonId: string,
		fromStat: RPGTeamBuilderStat, toStat: RPGTeamBuilderStat, amount: number, expectedRevision: number
	): RPGEVTrainingResult {
		this.revision(character, expectedRevision);
		const stats: RPGTeamBuilderStat[] = ['hp', 'atk', 'def', 'spa', 'spd', 'spe'];
		if (!stats.includes(fromStat) || !stats.includes(toStat)) {
			throw new Error('Atributo de treinamento de EV inv�lido');
		}
		if (fromStat === toStat) throw new Error('Escolha atributos diferentes para a transfer�ncia de EVs');
		if (!Number.isSafeInteger(amount) || amount < 4 || amount % 4 !== 0) {
			throw new Error('A quantidade de EVs deve ser um m�ltiplo positivo de 4');
		}
		const location = this.location(character.box, pokemonId);
		if (!location || location.destination !== 'party') {
			throw new Error('Somente Pok�mon da equipe podem treinar EVs');
		}
		const entry = this.requireEntry(character.box, pokemonId);
		const view = this.pokemonView({ entry, location });
		if (view.fainted) throw new Error('Um Pok�mon desmaiado n�o pode iniciar treinamento');
		const source = entry.pokemon.evs[fromStat] ?? 0;
		const destination = entry.pokemon.evs[toStat] ?? 0;
		if (source < amount) throw new Error('O atributo de origem n�o possui EVs suficientes');
		if (destination + amount > 252) throw new Error('O atributo de destino ultrapassaria 252 EVs');
		const steps = amount / 4;
		const cost = steps * 500;
		if (!Number.isSafeInteger(character.money) || character.money < cost) {
			throw new Error('Pokecoins insuficientes para o treinamento');
		}
		character.money -= cost;
		entry.pokemon.evs[fromStat] = source - amount;
		entry.pokemon.evs[toStat] = destination + amount;
		entry.pokemon.rpg.evs = { ...entry.pokemon.evs };
		entry.metadata = { ...(entry.metadata || {}), training: 'none' };
		delete entry.metadata.evTraining;
		this.commit(character);
		return {
			fromStat, toStat, amount, steps, cost,
			roleplayDurationMs: steps * 30 * 60 * 1000,
		};
	}


	static trainEVDistribution(
		character: RPGBoxCharacterData & { money: number }, pokemonId: string,
		values: Record<RPGTeamBuilderStat, number>, expectedRevision: number
	): RPGEVDistributionTrainingResult {
		this.revision(character, expectedRevision);
		const stats: RPGTeamBuilderStat[] = ['hp', 'atk', 'def', 'spa', 'spd', 'spe'];
		const location = this.location(character.box, pokemonId);
		if (!location || location.destination !== 'party') {
			throw new Error('Somente Pokémon da equipe podem treinar EVs');
		}
		const entry = this.requireEntry(character.box, pokemonId);
		const view = this.pokemonView({ entry, location });
		if (view.fainted) throw new Error('Um Pokémon desmaiado não pode iniciar treinamento');
		const next = {} as Record<RPGTeamBuilderStat, number>;
		const changes = {} as Record<RPGTeamBuilderStat, number>;
		for (const stat of stats) {
			const value = Number(values?.[stat]);
			if (!Number.isSafeInteger(value) || value < 0 || value > 252 || value % 4 !== 0) {
				throw new Error('Todos os EVs devem estar entre 0 e 252 e ser múltiplos de 4');
			}
			next[stat] = value;
			changes[stat] = value - (entry.pokemon.evs[stat] ?? 0);
		}
		const total = stats.reduce((sum, stat) => sum + next[stat], 0);
		if (total !== 508) throw new Error('A distribuição de EVs deve manter exatamente 508 pontos');
		const added = stats.reduce((sum, stat) => sum + Math.max(0, changes[stat]), 0);
		const removed = stats.reduce((sum, stat) => sum + Math.max(0, -changes[stat]), 0);
		if (!added || added !== removed || added % 4 !== 0) {
			throw new Error('Redistribua a mesma quantidade de EVs em múltiplos de 4');
		}
		const steps = added / 4;
		const cost = steps * 500;
		if (!Number.isSafeInteger(character.money) || character.money < cost) {
			throw new Error('Pokecoins insuficientes para o treinamento');
		}
		character.money -= cost;
		entry.pokemon.evs = { ...next };
		entry.pokemon.rpg.evs = { ...next };
		entry.metadata = { ...(entry.metadata || {}), training: 'none' };
		delete entry.metadata.evTraining;
		this.commit(character);
		return {
			values: { ...next }, changes: { ...changes }, amount: added, steps, cost,
			roleplayDurationMs: steps * 30 * 60 * 1000,
		};
	}


	static resolveEVTraining(character: RPGBoxCharacterData, pokemonId: string, _now: number): boolean {
		const entry = this.requireEntry(character.box, pokemonId);
		const job = entry.metadata?.evTraining;
		if (!job) return false;
		const current = entry.pokemon.evs[job.stat] ?? 0;
		const total = Object.values(entry.pokemon.evs).reduce((sum, value) => sum + (value || 0), 0);
		const gain = Math.max(0, Math.min(job.amount, 252 - current, 508 - total));
		entry.pokemon.evs[job.stat] = current + gain;
		entry.pokemon.rpg.evs = { ...entry.pokemon.evs };
		entry.metadata = { ...(entry.metadata || {}), training: 'none' };
		delete entry.metadata.evTraining;
		this.commit(character);
		return true;
	}

	static applyIVVitamin(
		character: RPGBoxCharacterData, pokemonId: string, stat: RPGTeamBuilderStat, expectedRevision: number
	): { stat: RPGTeamBuilderStat; previous: number; current: number } {
		this.revision(character, expectedRevision);
		if (!['hp', 'atk', 'def', 'spa', 'spd', 'spe'].includes(stat)) {
			throw new Error('Atributo de IV inválido');
		}
		const entry = this.requireEntry(character.box, pokemonId);
		const previous = entry.pokemon.ivs[stat] ?? 0;
		if (previous >= 31) throw new Error('Este IV já está no máximo');
		const current = Math.min(31, previous + 2);
		entry.pokemon.ivs[stat] = current;
		this.commit(character);
		return { stat, previous, current };
	}

	static teamBuilder(
		character: RPGBoxCharacterData, pokemonId: string, candidate: PokemonSet,
		expectedRevision: number, maxLevel: number, unrestricted = false
	): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		const current = this.capturedToSet(entry.pokemon);
		const dex = Dex.mod('gen9');

		if (unrestricted) {
			const species = dex.species.get(candidate.species);
			if (!species.exists) throw new Error('Invalid RPG Pokemon species');
			if (!Number.isSafeInteger(candidate.level) || candidate.level < 1 || candidate.level > maxLevel) {
				throw new Error('Invalid RPG Pokemon level');
			}
			if (!Array.isArray(candidate.moves) || !candidate.moves.length || candidate.moves.length > 4 ||
				candidate.moves.some(move => !dex.moves.get(move).exists) ||
				new Set(candidate.moves.map(toID)).size !== candidate.moves.length) {
				throw new Error('Invalid RPG Pokemon moves');
			}
			if (candidate.item && !dex.items.get(candidate.item).exists) throw new Error('Invalid RPG Pokemon item');
			if (!dex.abilities.get(candidate.ability).exists) throw new Error('Invalid RPG Pokemon ability');
			if (!dex.natures.get(candidate.nature).exists) throw new Error('Invalid RPG Pokemon nature');
			if (!['M', 'F', 'N'].includes(candidate.gender)) throw new Error('Invalid RPG Pokemon gender');
			const evs = Object.values(candidate.evs || {});
			const ivs = Object.values(candidate.ivs || {});
			if (evs.length !== 6 ||
				evs.some(value => !Number.isInteger(value) || value < 0 || value > 252 || value % 4 !== 0) ||
				evs.reduce((total, value) => total + value, 0) !== 508) {
				throw new Error('Invalid RPG Pokemon EVs');
			}
			if (ivs.some(value => !Number.isInteger(value) || value < 0 || value > 31)) {
				throw new Error('Invalid RPG Pokemon IVs');
			}
			const edited = structuredClone(candidate);
			edited.name = this.text(candidate.name || species.name, 'Pokemon nickname', 30);
			edited.rpg = structuredClone(current.rpg || {});
			edited.rpg.level = edited.level;
			edited.rpg.evs = { ...edited.evs };
			edited.rpg.item = edited.item;
			const previousPP = new Map(current.moves.map((move, index) => [
				toID(move), current.rpg?.pp?.[index] ?? dex.moves.get(move).pp ?? 1,
			]));
			edited.rpg.pp = edited.moves.map(move => {
				const maximum = dex.moves.get(move).pp || 1;
				return Math.max(0, Math.min(maximum, previousPP.get(toID(move)) ?? maximum));
			});
			if (edited.level !== current.level) {
				const experience = getSpeciesExperience(species.id);
				if (experience) {
					edited.rpg.experience = getExperienceForLevel(
						experience.growthRate, Math.min(edited.level, 100)
					);
				}
			}
			entry.pokemon = this.setToCaptured(edited);
			this.commit(character);
			return;
		}
		if (candidate.moves?.some(move => !dex.moves.get(move).exists)) {
			throw new Error('Invalid RPG Pokemon move');
		}
		if (candidate.item && !dex.items.get(candidate.item).exists) throw new Error('Invalid RPG Pokemon item');
		const species = dex.species.get(current.species);
		const abilities = Object.values(species.abilities).map(ability => toID(ability));
		if (!abilities.includes(toID(candidate.ability))) throw new Error('Invalid RPG Pokemon ability');
		const edited = RPGTeamBuilderSystem.apply([current], [candidate], {
			editable: {
				moves: true, evs: true, ivs: true, item: true,
				ability: true, level: true,
			},
			minLevel: 1, maxLevel, maxMoves: 4,
			maxEVPerStat: 252, maxTotalEVs: 508, maxIVPerStat: 31,
		})[0];
		entry.pokemon = {
			name: edited.name, species: edited.species, level: edited.level,
			gender: edited.gender, shiny: !!edited.shiny, item: edited.item,
			ability: edited.ability, nature: edited.nature, moves: [...edited.moves],
			evs: { ...edited.evs }, ivs: { ...edited.ivs }, rpg: structuredClone(edited.rpg || {}),
		};
		this.commit(character);
	}

	static masterEdit(
		character: RPGBoxCharacterData, pokemonId: string, edit: RPGBoxMasterEdit, expectedRevision: number
	): void {
		this.revision(character, expectedRevision);
		const entry = this.requireEntry(character.box, pokemonId);
		const dex = Dex.mod('gen9');
		if (edit.species !== undefined) {
			const species = dex.species.get(edit.species);
			if (!species.exists) throw new Error('Invalid RPG Pokemon species');
			entry.pokemon.species = species.name;
		}
		if (edit.item !== undefined) {
			if (edit.item && !dex.items.get(edit.item).exists) throw new Error('Invalid RPG Pokemon item');
			entry.pokemon.item = toID(edit.item);
			entry.pokemon.rpg.item = toID(edit.item);
		}
		if (edit.status !== undefined) {
			const status = toID(edit.status);
			if (status && !['brn', 'par', 'psn', 'tox', 'slp', 'frz'].includes(status)) {
				throw new Error('Invalid RPG Pokemon status');
			}
			entry.pokemon.rpg.status = status;
		}
		const maxHP = this.pokemonView({
			entry, location: this.location(character.box, pokemonId)!,
		}).maxHP;
		if (edit.hp !== undefined) {
			if (!Number.isSafeInteger(edit.hp) || edit.hp < 0 || edit.hp > maxHP) {
				throw new Error('Invalid RPG Pokemon HP');
			}
			entry.pokemon.rpg.hp = edit.hp;
		}
		if (edit.pp !== undefined) {
			const maximum = entry.pokemon.moves.map(move => dex.moves.get(move).pp || 1);
			if (edit.pp.length !== maximum.length || edit.pp.some((pp, index) =>
				!Number.isSafeInteger(pp) || pp < 0 || pp > maximum[index]
			)) throw new Error('Invalid RPG Pokemon PP');
			entry.pokemon.rpg.pp = [...edit.pp];
		}
		if (edit.experience !== undefined) {
			if (!Number.isSafeInteger(edit.experience) || edit.experience < 0) {
				throw new Error('Invalid RPG Pokemon experience');
			}
			entry.pokemon.rpg.experience = edit.experience;
		}
		if (edit.ot !== undefined) {
			entry.metadata = { ...(entry.metadata || {}), ot: this.text(edit.ot, 'OT', 50) };
		}
		this.commit(character);
	}

	static insert(character: RPGBoxCharacterData, entry: RPGManagedStoredPokemon): void {
		if (!entry || typeof entry.pokemonId !== 'string' || !entry.pokemonId.trim() || !entry.pokemon) {
			throw new Error('Invalid RPG Box Pokemon');
		}
		if (this.location(character.box, entry.pokemonId)) throw new Error('RPG Box Pokemon is already stored');
		const dex = Dex.mod('gen9');
		const species = dex.species.get(entry.pokemon.species);
		if (!species.exists) throw new Error('Invalid RPG Pokemon species');
		if (!Number.isSafeInteger(entry.pokemon.level) || entry.pokemon.level < 1 || entry.pokemon.level > 999) {
			throw new Error('RPG Box Pokemon level must be between 1 and 999');
		}
		if (!Array.isArray(entry.pokemon.moves) || !entry.pokemon.moves.length || entry.pokemon.moves.length > 4 ||
			entry.pokemon.moves.some(move => !dex.moves.get(move).exists)) {
			throw new Error('Invalid RPG Box Pokemon moves');
		}
		if (!entry.pokemon.rpg || typeof entry.pokemon.rpg !== 'object') {
			throw new Error('RPG Box Pokemon requires persistent state');
		}
		const box = character.box.boxes.find(candidate => candidate.slots.some(slot => !slot));
		if (!box) throw new Error('RPG Box storage is full');
		box.slots[box.slots.findIndex(value => !value)] = structuredClone(entry);
		this.commit(character);
	}

	static extract(character: RPGBoxCharacterData, pokemonId: string, expectedRevision: number): RPGManagedStoredPokemon {
		this.revision(character, expectedRevision);
		const location = this.location(character.box, pokemonId);
		if (!location) throw new Error('Unknown RPG Box Pokemon');
		const entry = this.remove(character.box, location) as RPGManagedStoredPokemon;
		character.box.placements = character.box.placements.filter(value => value.pokemonId !== pokemonId);
		this.commit(character);
		return entry;
	}

	private static entries(character: RPGBoxCharacterData) {
		const result: { entry: RPGManagedStoredPokemon, location: RPGBoxLocation }[] = [];
		character.box.party.forEach((entry, position) => result.push({
			entry: entry as RPGManagedStoredPokemon, location: { destination: 'party', position },
		}));
		for (const box of character.box.boxes) box.slots.forEach((entry, slot) => {
			if (entry) result.push({
				entry: entry as RPGManagedStoredPokemon,
				location: { destination: 'box', boxIndex: box.index, slot },
			});
		});
		return result;
	}

	private static pokemonView(stored: {
		entry: RPGManagedStoredPokemon; location: RPGBoxLocation;
	}): RPGBoxPokemonView {
		const pokemon = stored.entry.pokemon;
		const dex = Dex.mod('gen9');
		const species = dex.species.get(pokemon.species);
		const level = pokemon.level;
		const maxHP = species.id === 'shedinja' ? 1 :
			Math.floor((2 * species.baseStats.hp + (pokemon.ivs?.hp ?? 31) +
			Math.floor((pokemon.evs?.hp ?? 0) / 4)) * level / 100) + level + 10;
		const hp = Math.max(0, Math.min(maxHP, pokemon.rpg.hp ?? maxHP));
		const moves = pokemon.moves.map((move, index) => {
			const data = dex.moves.get(move);
			const maxPP = data.pp || 1;
			return {
				id: data.id, name: data.name, type: data.type, category: data.category,
				pp: Math.max(0, Math.min(maxPP, pokemon.rpg.pp?.[index] ?? maxPP)), maxPP,
			};
		});
		const metadata = {
			favorite: !!stored.entry.metadata?.favorite,
			...(stored.entry.metadata?.favorite ?
				{ favoriteMarker: stored.entry.metadata.favoriteMarker || 'star' as RPGBoxFavoriteMarker } : {}),
			companion: !!stored.entry.metadata?.companion,
			training: stored.entry.metadata?.training || 'none' as RPGBoxTrainingState,
			...(stored.entry.metadata?.lastBattleAt === undefined ? {} :
				{ lastBattleAt: stored.entry.metadata.lastBattleAt }),
			...(stored.entry.metadata?.ot === undefined ? {} : { ot: stored.entry.metadata.ot }),
			...(stored.entry.metadata?.evTraining === undefined ? {} : {
				evTraining: structuredClone(stored.entry.metadata.evTraining),
			}),
		};
		const status = toID(pokemon.rpg.status || '');
		const indicators: string[] = [];
		if (species.tags.some(tag => String(tag).includes('Legendary') || tag === 'Mythical')) indicators.push('legendary');
		if (metadata.favorite) indicators.push('favorite');
		if (metadata.companion) indicators.push('companion');
		if (metadata.training !== 'none') indicators.push('training');
		if (hp <= 0) indicators.push('fainted');
		return {
			pokemonId: stored.entry.pokemonId, location: structuredClone(stored.location),
			name: pokemon.name || species.name, species: species.name, speciesId: species.id,
			pokedexNumber: species.num, types: [...species.types], spriteId: species.id,
			level, experience: pokemon.rpg.experience ?? 0, hp, maxHP, status, fainted: hp <= 0,
			item: pokemon.item || '', nature: pokemon.nature, ability: pokemon.ability,
			gender: pokemon.gender, shiny: pokemon.shiny, moves,
			evs: structuredClone(pokemon.evs), ivs: structuredClone(pokemon.ivs), metadata, indicators,
			actions: {
				move: true, release: true,
				center: hp < maxHP || !!status || moves.some(move => move.pp < move.maxPP),
				training: hp > 0, favorite: true, teamBuilder: true,
			},
		};
	}

	private static location(storage: RPGBoxState, pokemonId: string): RPGBoxLocation | undefined {
		const party = storage.party.findIndex(entry => entry.pokemonId === pokemonId);
		if (party >= 0) return { destination: 'party', position: party };
		for (const box of storage.boxes) {
			const slot = box.slots.findIndex(entry => entry?.pokemonId === pokemonId);
			if (slot >= 0) return { destination: 'box', boxIndex: box.index, slot };
		}
	}

	private static requireEntry(storage: RPGBoxState, pokemonId: string): RPGManagedStoredPokemon {
		const location = this.location(storage, pokemonId);
		if (!location) throw new Error('Unknown RPG Box Pokemon');
		return (location.destination === 'party' ? storage.party[location.position] :
			storage.boxes[location.boxIndex].slots[location.slot]) as RPGManagedStoredPokemon;
	}

	private static entryAt(storage: RPGBoxState, location: RPGBoxLocation): RPGStoredPokemon | null | undefined {
		return location.destination === 'party' ? storage.party[location.position] :
			storage.boxes[location.boxIndex].slots[location.slot];
	}

	private static setEntry(storage: RPGBoxState, location: RPGBoxLocation, entry: RPGStoredPokemon): void {
		if (location.destination === 'party') storage.party[location.position] = entry;
		else storage.boxes[location.boxIndex].slots[location.slot] = entry;
	}
	private static remove(storage: RPGBoxState, location: RPGBoxLocation): RPGStoredPokemon {
		if (location.destination === 'party') return storage.party.splice(location.position, 1)[0];
		const entry = storage.boxes[location.boxIndex].slots[location.slot];
		if (!entry) throw new Error('RPG Box location is empty');
		storage.boxes[location.boxIndex].slots[location.slot] = null;
		return entry;
	}

	private static restore(storage: RPGBoxState, location: RPGBoxLocation, entry: RPGStoredPokemon): void {
		if (location.destination === 'party') storage.party.splice(location.position, 0, entry);
		else storage.boxes[location.boxIndex].slots[location.slot] = entry;
	}

	private static validateDestination(storage: RPGBoxState, location: RPGBoxLocation): void {
		if (location.destination === 'party') {
			if (!Number.isSafeInteger(location.position) || location.position < 0 || location.position > 5) {
				throw new Error('Invalid RPG party position');
			}
			return;
		}
		if (location.destination !== 'box' || !Number.isSafeInteger(location.boxIndex) ||
			location.boxIndex < 0 || location.boxIndex >= storage.boxes.length ||
			!Number.isSafeInteger(location.slot) || location.slot < 0 ||
			location.slot >= storage.boxes[location.boxIndex].slots.length) {
			throw new Error('Invalid RPG Box destination');
		}
	}

	private static sameLocation(left: RPGBoxLocation, right: RPGBoxLocation): boolean {
		return left.destination === 'party' && right.destination === 'party' ? left.position === right.position :
			left.destination === 'box' && right.destination === 'box' &&
			left.boxIndex === right.boxIndex && left.slot === right.slot;
	}

	private static revision(character: RPGBoxCharacterData, expected: number): void {
		if (!Number.isSafeInteger(expected) || expected !== character.box.revision) {
			throw new Error('RPG Box revision conflict');
		}
	}

	private static commit(character: RPGBoxCharacterData): void {
		character.box.revision++;
		character.team = character.box.party.map(entry => this.capturedToSet(entry.pokemon));
		for (const placement of character.box.placements) {
			const location = this.location(character.box, placement.pokemonId);
			if (location) placement.location = location;
		}
		RPGBoxSystem.getCapacity(character.box);
	}


	private static setToCaptured(set: PokemonSet): RPGCapturedPokemon {
		return {
			name: set.name, species: set.species, level: set.level, gender: set.gender,
			shiny: !!set.shiny, item: set.item, ability: set.ability, nature: set.nature,
			moves: [...set.moves], evs: { ...set.evs }, ivs: { ...set.ivs },
			rpg: structuredClone(set.rpg || {}),
		};
	}

	private static capturedToSet(pokemon: RPGCapturedPokemon): PokemonSet {
		return {
			name: pokemon.name, species: pokemon.species, level: pokemon.level, gender: pokemon.gender,
			shiny: pokemon.shiny, item: pokemon.item, ability: pokemon.ability, nature: pokemon.nature,
			moves: [...pokemon.moves], evs: { ...pokemon.evs }, ivs: { ...pokemon.ivs },
			rpg: structuredClone(pokemon.rpg),
		};
	}

	private static text(value: string, field: string, maximum: number): string {
		const text = typeof value === 'string' ? value.trim() : '';
		if (!text || text.length > maximum) {
			throw new Error(`RPG ${field} must contain between 1 and ${maximum} characters`);
		}
		return text;
	}
}

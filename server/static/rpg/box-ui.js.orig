'use strict';

(function defineRPGBoxUI() {
	const TYPES = [
		'Normal', 'Fire', 'Water', 'Electric', 'Grass', 'Ice', 'Fighting', 'Poison', 'Ground',
		'Flying', 'Psychic', 'Bug', 'Rock', 'Ghost', 'Dragon', 'Dark', 'Steel', 'Fairy',
	];
	const BACKGROUND_KEY = 'rpg-box-backgrounds-v1';
	const ui = {
		index: 0, selectedId: null, search: '', type: 'all', status: 'all',
		catalog: null,
	};

	function el(tag, className, text) {
		const node = document.createElement(tag);
		if (className) node.className = className;
		if (text !== undefined) node.textContent = text;
		return node;
	}
	function button(text, className = 'button') {
		const node = el('button', className, text);
		node.type = 'button';
		return node;
	}
	function backgroundSettings() {
		try {
			return JSON.parse(localStorage.getItem(BACKGROUND_KEY) || '{}');
		} catch {
			return {};
		}
	}
	function backgroundId(ownerId, index) {
		return backgroundSettings()[ownerId + ':' + index] || 'type-grass';
	}
	function saveBackground(ownerId, index, id) {
		const settings = backgroundSettings();
		settings[ownerId + ':' + index] = id;
		localStorage.setItem(BACKGROUND_KEY, JSON.stringify(settings));
	}
	function backgroundUrl(id) {
		return new URL('./assets/box-backgrounds/' + id + '.png', document.baseURI).href;
	}
	async function catalog() {
		if (ui.catalog) return ui.catalog;
		const response = await fetch(new URL('./assets/box-backgrounds/catalog.json', document.baseURI));
		if (!response.ok) throw new Error('Não foi possível carregar os fundos da Box.');
		const data = await response.json();
		ui.catalog = data.backgrounds || data;
		return ui.catalog;
	}
	function pokemonImage(deps, pokemon) {
		const image = el('img', 'box-pokemon-image');
		image.src = deps.spriteUrl(pokemon);
		image.alt = pokemon.name + ' em pixel art';
		image.loading = 'lazy';
		image.draggable = false;
		return image;
	}
	function indicators(pokemon) {
		const names = {
			legendary: ['?', 'Lendário'], favorite: ['?', 'Favorito'],
			companion: ['?', 'Companheiro'], training: ['?', 'Em treinamento'],
			fainted: ['?', 'Desmaiado'],
		};
		const group = el('span', 'box-indicators');
		for (const id of pokemon.indicators || []) {
			if (!names[id]) continue;
			const badge = el('span', 'box-indicator ' + id, names[id][0]);
			badge.title = names[id][1];
			group.append(badge);
		}
		return group;
	}
	function allPokemon(view) {
		return [...view.team, ...view.boxes.flatMap(box => box.pokemon)];
	}
	function currentBox(view) {
		return view.boxes.find(box => box.index === ui.index) || view.boxes[0];
	}
	function firstEmpty(box) {
		const used = new Set(box.pokemon.map(pokemon => pokemon.location.slot));
		for (let slot = 0; slot < box.capacity; slot++) if (!used.has(slot)) return slot;
		return -1;
	}
	async function loadView(deps) {
		const query = new URLSearchParams({
			characterId: deps.characterId,
			boxIndex: String(ui.index),
		});
		if (ui.search) query.set('search', ui.search);
		if (ui.type !== 'all') query.set('type', ui.type);
		if (ui.status !== 'all') query.set('status', ui.status);
		return (await deps.api('/box?' + query)).box;
	}
	async function action(deps, operation, message) {
		try {
			await operation();
			if (message) deps.toast(message);
			await deps.refresh();
		} catch (error) {
			deps.toast(error.message, true);
		}
	}
	function move(deps, view, pokemonId, destination) {
		return action(deps, () => deps.api('/box/move', {
			method: 'POST',
			body: {
				characterId: deps.characterId, pokemonId, destination,
				expectedRevision: view.revision,
			},
		}), 'Pokémon movido.');
	}
	function draggable(node, pokemonId) {
		node.draggable = true;
		node.addEventListener('dragstart', event => {
			event.dataTransfer.effectAllowed = 'move';
			event.dataTransfer.setData('text/rpg-pokemon-id', pokemonId);
			node.classList.add('dragging');
		});
		node.addEventListener('dragend', () => node.classList.remove('dragging'));
	}
	function droppable(node, deps, view, destination) {
		node.addEventListener('dragover', event => {
			event.preventDefault();
			node.classList.add('drop-target');
		});
		node.addEventListener('dragleave', () => node.classList.remove('drop-target'));
		node.addEventListener('drop', event => {
			event.preventDefault();
			node.classList.remove('drop-target');
			const pokemonId = event.dataTransfer.getData('text/rpg-pokemon-id');
			if (pokemonId) void move(deps, view, pokemonId, destination);
		});
	}
	function teamPanel(deps, view) {
		const panel = el('section', 'panel box-team-panel');
		const heading = el('div', 'box-section-heading');
		heading.append(el('h2', '', 'Equipe atual'), el('span', 'tag', view.team.length + ' / 6'));
		panel.append(heading);
		const grid = el('div', 'box-team-grid');
		const byPosition = new Map(view.team.map(pokemon => [pokemon.location.position, pokemon]));
		for (let position = 0; position < 6; position++) {
			const pokemon = byPosition.get(position);
			const slot = button('', 'box-team-slot ' + (pokemon ? 'occupied' : 'empty'));
			slot.append(el('span', 'box-team-number', String(position + 1)));
			if (pokemon) {
				slot.append(pokemonImage(deps, pokemon), el('strong', '', pokemon.name), indicators(pokemon));
				slot.title = pokemon.species + ' · Nv. ' + pokemon.level;
				slot.addEventListener('click', () => {
					ui.selectedId = pokemon.pokemonId;
					void deps.refresh();
				});
				draggable(slot, pokemon.pokemonId);
			} else {
				slot.append(el('span', 'box-empty-label', 'Adicionar'));
				droppable(slot, deps, view, { destination: 'party', position });
			}
			grid.append(slot);
		}
		panel.append(grid);
		return panel;
	}
	function filterLabel(label, values, selected, changed) {
		const field = el('label', 'box-filter');
		field.append(el('span', '', label));
		const select = el('select');
		for (const [value, text] of values) {
			const option = el('option', '', text);
			option.value = value;
			option.selected = selected === value;
			select.append(option);
		}
		select.addEventListener('change', () => changed(select.value));
		field.append(select);
		return field;
	}
	function toolbar(deps) {
		const bar = el('div', 'panel box-toolbar');
		const search = el('label', 'box-search');
		search.append(el('span', '', 'Pesquisar'));
		const input = el('input');
		input.type = 'search';
		input.placeholder = 'Nome, espécie ou Nº da Pokédex';
		input.value = ui.search;
		let timer;
		input.addEventListener('input', () => {
			clearTimeout(timer);
			timer = setTimeout(() => {
				ui.search = input.value.trim();
				void deps.refresh();
			}, 250);
		});
		search.append(input);
		const typeValues = [['all', 'Todos'], ...TYPES.map(type => [type, type])];
		const statusValues = [
			['all', 'Todos'], ['healthy', 'Saudáveis'], ['alive', 'Vivos'],
			['fainted', 'Desmaiados'], ['statused', 'Com status'], ['psn', 'Envenenados'],
			['brn', 'Queimados'], ['par', 'Paralisados'], ['slp', 'Dormindo'], ['frz', 'Congelados'],
		];
		bar.append(
			search,
			filterLabel('Tipo', typeValues, ui.type, value => {
				ui.type = value;
				void deps.refresh();
			}),
			filterLabel('Status', statusValues, ui.status, value => {
				ui.status = value;
				void deps.refresh();
			})
		);
		return bar;
	}
	function tabs(deps, view) {
		const list = el('div', 'box-tabs');
		for (const box of view.boxes) {
			const tab = button('', 'box-tab' + (box.index === ui.index ? ' active' : ''));
			tab.append(el('strong', '', box.name), el('small', '', (box.index + 1) + ' · ' + box.used + '/' + box.capacity));
			tab.addEventListener('click', () => {
				ui.index = box.index;
				ui.selectedId = null;
				void deps.refresh();
			});
			list.append(tab);
		}
		return list;
	}
	function renameBox(deps, view, box, title) {
		title.replaceChildren();
		const input = el('input', 'box-name-input');
		input.value = box.name;
		input.maxLength = 30;
		const save = button('Salvar', 'button primary small');
		const cancel = button('Cancelar', 'button small');
		const submit = () => void action(deps, () => deps.api('/box/boxes/' + box.index, {
			method: 'PATCH',
			body: {
				characterId: deps.characterId, name: input.value,
				expectedRevision: view.revision,
			},
		}), 'Box renomeada.');
		save.addEventListener('click', submit);
		cancel.addEventListener('click', () => void deps.refresh());
		input.addEventListener('keydown', event => {
			if (event.key === 'Enter') submit();
			if (event.key === 'Escape') void deps.refresh();
		});
		title.append(input, save, cancel);
		input.focus();
		input.select();
	}
	function backgroundPicker(deps, view, box, stage, backgrounds) {
		const picker = el('div', 'box-background-picker hidden');
		const heading = el('div', 'box-picker-heading');
		heading.append(el('strong', '', 'Escolha o fundo da Box'));
		const close = button('×', 'box-picker-close');
		close.addEventListener('click', () => picker.classList.add('hidden'));
		heading.append(close);
		picker.append(heading);
		const options = el('div', 'box-background-options');
		const current = backgroundId(view.ownerId, box.index);
		for (const background of backgrounds) {
			const option = button('', 'box-background-option' + (current === background.id ? ' selected' : ''));
			const preview = el('img');
			preview.src = backgroundUrl(background.id);
			preview.alt = '';
			option.append(preview, el('span', '', background.name));
			option.addEventListener('click', () => {
				saveBackground(view.ownerId, box.index, background.id);
				stage.style.backgroundImage = 'url("' + backgroundUrl(background.id) + '")';
				for (const child of options.children) child.classList.remove('selected');
				option.classList.add('selected');
				picker.classList.add('hidden');
			});
			options.append(option);
		}
		picker.append(options);
		return picker;
	}
	function boxGrid(deps, view, backgrounds) {
		const box = currentBox(view);
		const panel = el('section', 'panel box-storage-panel');
		if (!box) {
			panel.append(el('p', 'empty-state', 'Nenhuma Box disponível.'));
			return panel;
		}
		const heading = el('div', 'box-storage-heading');
		const title = el('div', 'box-storage-title');
		title.append(el('h2', '', box.name), el('small', '', box.used + ' de ' + box.capacity + ' espaços ocupados'));
		const rename = button('Renomear', 'button small');
		rename.addEventListener('click', () => renameBox(deps, view, box, title));
		const chooseBackground = button('Escolher fundo', 'button small');
		heading.append(title, rename, chooseBackground);
		panel.append(heading);
		const stage = el('div', 'box-stage');
		stage.style.backgroundImage = 'url("' + backgroundUrl(backgroundId(view.ownerId, box.index)) + '")';
		const filtering = !!ui.search || ui.type !== 'all' || ui.status !== 'all';
		const visible = new Set((filtering ? view.results : box.pokemon).map(pokemon => pokemon.pokemonId));
		const bySlot = new Map(box.pokemon.map(pokemon => [pokemon.location.slot, pokemon]));
		for (let slotIndex = 0; slotIndex < box.capacity; slotIndex++) {
			const pokemon = bySlot.get(slotIndex);
			const slot = button('', 'box-grid-slot ' + (pokemon ? 'occupied' : 'empty'));
			if (pokemon) {
				if (!visible.has(pokemon.pokemonId)) slot.classList.add('filtered');
				if (pokemon.pokemonId === ui.selectedId) slot.classList.add('selected');
				slot.append(pokemonImage(deps, pokemon), indicators(pokemon));
				slot.title = pokemon.name + ' · ' + pokemon.species + ' · Nv. ' + pokemon.level;
				slot.addEventListener('click', () => {
					ui.selectedId = pokemon.pokemonId;
					void deps.refresh();
				});
				draggable(slot, pokemon.pokemonId);
			} else {
				slot.setAttribute('aria-label', 'Espaço vazio ' + (slotIndex + 1));
				droppable(slot, deps, view, { destination: 'box', boxIndex: box.index, slot: slotIndex });
			}
			stage.append(slot);
		}
		if (filtering && !view.results.length) stage.append(el('p', 'box-no-results', 'Nenhum Pokémon encontrado.'));
		const picker = backgroundPicker(deps, view, box, stage, backgrounds);
		chooseBackground.addEventListener('click', () => picker.classList.toggle('hidden'));
		panel.append(stage, picker);
		return panel;
	}
	function statTable(title, stats) {
		const section = el('section', 'box-detail-section');
		section.append(el('h4', '', title));
		const table = el('div', 'box-stat-table');
		const labels = { hp: 'HP', atk: 'Atk', def: 'Def', spa: 'SpA', spd: 'SpD', spe: 'Spe' };
		for (const id of Object.keys(labels)) {
			table.append(el('span', '', labels[id]), el('strong', '', String(stats?.[id] ?? 0)));
		}
		section.append(table);
		return section;
	}
	function editorField(label, value, type = 'text') {
		const field = el('label', 'field');
		field.append(el('span', '', label));
		const input = el('input');
		input.type = type;
		input.value = value ?? '';
		field.append(input);
		return { field, input };
	}
	function openTeamBuilder(deps, view, pokemon, drawer) {
		const form = el('form', 'box-editor-form');
		form.append(el('h3', '', 'Team Builder · ' + pokemon.name));
		const level = editorField('Nível', pokemon.level, 'number');
		const item = editorField('Item', pokemon.item);
		const ability = editorField('Ability', pokemon.ability);
		const moves = editorField('Movimentos (separados por vírgula)', pokemon.moves.map(move => move.name).join(', '));
		form.append(level.field, item.field, ability.field, moves.field);
		const stats = el('div', 'box-editor-stats');
		const evs = {}, ivs = {};
		for (const id of ['hp', 'atk', 'def', 'spa', 'spd', 'spe']) {
			evs[id] = editorField('EV ' + id.toUpperCase(), pokemon.evs?.[id] ?? 0, 'number');
			ivs[id] = editorField('IV ' + id.toUpperCase(), pokemon.ivs?.[id] ?? 31, 'number');
			stats.append(evs[id].field, ivs[id].field);
		}
		form.append(stats);
		const controls = el('div', 'form-actions');
		const cancel = button('Cancelar');
		cancel.addEventListener('click', () => void deps.refresh());
		const save = el('button', 'button primary', 'Salvar alterações');
		save.type = 'submit';
		controls.append(cancel, save);
		form.append(controls);
		form.addEventListener('submit', event => {
			event.preventDefault();
			const nextEvs = {}, nextIvs = {};
			for (const id of Object.keys(evs)) {
				nextEvs[id] = Number(evs[id].input.value);
				nextIvs[id] = Number(ivs[id].input.value);
			}
			void action(deps, () => deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId) + '/team-builder', {
				method: 'POST',
				body: {
					characterId: deps.characterId, expectedRevision: view.revision,
					pokemon: {
						name: pokemon.name, species: pokemon.species, gender: pokemon.gender,
						shiny: pokemon.shiny, nature: pokemon.nature,
						level: Number(level.input.value), item: item.input.value,
						ability: ability.input.value,
						moves: moves.input.value.split(',').map(value => value.trim()).filter(Boolean),
						evs: nextEvs, ivs: nextIvs,
					},
				},
			}), 'Pokémon atualizado no Team Builder.');
		});
		drawer.replaceChildren(form);
	}
	function openMasterEditor(deps, view, pokemon, drawer) {
		const form = el('form', 'box-editor-form');
		form.append(el('h3', '', 'Edição do Mestre · ' + pokemon.name));
		const hp = editorField('HP atual', pokemon.hp, 'number');
		const experience = editorField('Experiência', pokemon.experience, 'number');
		const status = editorField('Status', pokemon.status);
		const item = editorField('Item', pokemon.item);
		const ot = editorField('OT', pokemon.metadata.ot || '');
		form.append(hp.field, experience.field, status.field, item.field, ot.field);
		const controls = el('div', 'form-actions');
		const cancel = button('Cancelar');
		cancel.addEventListener('click', () => void deps.refresh());
		const save = el('button', 'button primary', 'Salvar');
		save.type = 'submit';
		controls.append(cancel, save);
		form.append(controls);
		form.addEventListener('submit', event => {
			event.preventDefault();
			void action(deps, () => deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId), {
				method: 'PATCH',
				body: {
					characterId: deps.characterId, expectedRevision: view.revision,
					edit: {
						hp: Number(hp.input.value), experience: Number(experience.input.value),
						status: status.input.value, item: item.input.value, ot: ot.input.value,
					},
				},
			}), 'Alterações do Mestre salvas.');
		});
		drawer.replaceChildren(form);
	}
	function openRelease(deps, view, pokemon, drawer) {
		const dialog = el('div', 'box-release-dialog');
		dialog.append(
			el('h3', '', 'Liberar ' + pokemon.name + '?'),
			el('p', '', 'Esta ação retira o Pokémon permanentemente. Ela não pode ser desfeita.')
		);
		const controls = el('div', 'form-actions');
		const no = button('Não');
		no.addEventListener('click', () => void deps.refresh());
		const yes = button('Sim, liberar', 'button danger destructive');
		yes.addEventListener('click', async () => {
			try {
				const result = await deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId) + '/release-challenge', {
					method: 'POST',
					body: { characterId: deps.characterId, expectedRevision: view.revision },
				});
				await deps.api('/box/pokemon', {
					method: 'DELETE',
					body: { challengeId: result.challenge.challengeId, confirmed: true },
				});
				ui.selectedId = null;
				deps.toast(pokemon.name + ' foi liberado.');
				await deps.refresh();
			} catch (error) {
				deps.toast(error.message, true);
			}
		});
		controls.append(no, yes);
		dialog.append(controls);
		drawer.replaceChildren(dialog);
	}
	function details(deps, view, pokemon) {
		const drawer = el('aside', 'panel box-detail-drawer');
		const hero = el('div', 'box-detail-hero');
		const identity = el('div', 'box-detail-identity');
		identity.append(
			el('h2', '', pokemon.name),
			el('small', '', '#' + String(pokemon.pokedexNumber).padStart(4, '0') + ' · ' + pokemon.species)
		);
		const types = el('div', 'box-type-list');
		for (const type of pokemon.types) types.append(el('span', 'box-type type-' + type.toLowerCase(), type));
		identity.append(types);
		const close = button('×', 'box-detail-close');
		close.addEventListener('click', () => {
			ui.selectedId = null;
			void deps.refresh();
		});
		hero.append(pokemonImage(deps, pokemon), identity, indicators(pokemon), close);
		drawer.append(hero);
		const summary = el('dl', 'box-detail-summary');
		for (const [label, value] of [
			['Nível', pokemon.level], ['Experiência', pokemon.experience],
			['HP', pokemon.hp + ' / ' + pokemon.maxHP], ['Status', pokemon.status || 'Saudável'],
			['Item', pokemon.item || 'Nenhum'], ['Nature', pokemon.nature],
			['Ability', pokemon.ability], ['Gênero', pokemon.gender || 'N'],
		]) summary.append(el('dt', '', label), el('dd', '', String(value)));
		drawer.append(summary);
		const moves = el('section', 'box-detail-section');
		moves.append(el('h4', '', 'Movimentos'));
		const list = el('div', 'box-move-list');
		for (const moveData of pokemon.moves) {
			const row = el('div', 'box-move-row type-border-' + moveData.type.toLowerCase());
			row.append(
				el('strong', '', moveData.name), el('span', 'box-move-type', moveData.type),
				el('small', '', moveData.category + ' · PP ' + moveData.pp + '/' + moveData.maxPP)
			);
			list.append(row);
		}
		moves.append(list);
		drawer.append(moves, statTable('EVs', pokemon.evs), statTable('IVs', pokemon.ivs));
		const rpg = el('section', 'box-detail-section');
		rpg.append(el('h4', '', 'Informações RPG'));
		const rpgList = el('dl', 'box-rpg-list');
		const lastBattle = pokemon.metadata.lastBattleAt ?
			new Date(pokemon.metadata.lastBattleAt).toLocaleString('pt-BR') : 'Nenhuma registrada';
		for (const [label, value] of [
			['Estado', pokemon.fainted ? 'Desmaiado' : pokemon.status || 'Saudável'],
			['Última batalha', lastBattle], ['Treinamento', pokemon.metadata.training || 'none'],
			['OT', pokemon.metadata.ot || 'Não informado'],
		]) rpgList.append(el('dt', '', label), el('dd', '', value));
		rpg.append(rpgList);
		drawer.append(rpg);
		const actions = el('div', 'box-detail-actions');
		const heal = button('Curar', 'button primary');
		heal.disabled = !pokemon.actions.center;
		heal.addEventListener('click', () => void action(deps, () =>
			deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId) + '/center', {
				method: 'POST',
				body: { characterId: deps.characterId, expectedRevision: view.revision },
			}), 'Pokémon restaurado no Centro Pokémon.'));
		const favorite = button(pokemon.metadata.favorite ? 'Remover favorito' : 'Favoritar');
		favorite.addEventListener('click', () => void action(deps, () =>
			deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId) + '/metadata', {
				method: 'POST',
				body: {
					characterId: deps.characterId, expectedRevision: view.revision,
					metadata: { favorite: !pokemon.metadata.favorite },
				},
			}), pokemon.metadata.favorite ? 'Removido dos favoritos.' : 'Adicionado aos favoritos.'));
		const training = button(pokemon.metadata.training === 'none' ? 'Treinamento' : 'Parar treinamento');
		training.disabled = !pokemon.actions.training;
		training.addEventListener('click', () => void action(deps, () =>
			deps.api('/box/pokemon/' + encodeURIComponent(pokemon.pokemonId) + '/metadata', {
				method: 'POST',
				body: {
					characterId: deps.characterId, expectedRevision: view.revision,
					metadata: { training: pokemon.metadata.training === 'none' ? 'ev' : 'none' },
				},
			}), 'Treinamento atualizado.'));
		const destination = el('select', 'box-move-select');
		destination.append(el('option', '', 'Mover para...'));
		const team = el('option', '', 'Equipe');
		team.value = 'party';
		team.disabled = view.team.length >= 6 || pokemon.location.destination === 'party';
		destination.append(team);
		for (const box of view.boxes) {
			const option = el('option', '', box.name);
			option.value = 'box:' + box.index;
			option.disabled = box.used >= box.capacity ||
				(pokemon.location.destination === 'box' && pokemon.location.boxIndex === box.index);
			destination.append(option);
		}
		destination.addEventListener('change', () => {
			if (destination.value === 'party') {
				void move(deps, view, pokemon.pokemonId, { destination: 'party', position: view.team.length });
			} else if (destination.value.startsWith('box:')) {
				const box = view.boxes.find(item => item.index === Number(destination.value.slice(4)));
				const slot = firstEmpty(box);
				if (slot >= 0) void move(deps, view, pokemon.pokemonId, {
					destination: 'box', boxIndex: box.index, slot,
				});
			}
		});
		const builder = button('Abrir Team Builder');
		builder.addEventListener('click', () => openTeamBuilder(deps, view, pokemon, drawer));
		const release = button('Liberar Pokémon', 'button danger');
		release.addEventListener('click', () => openRelease(deps, view, pokemon, drawer));
		actions.append(heal, favorite, training, destination, builder, release);
		if (deps.isMaster) {
			const master = button('Editar como Mestre', 'button master-action');
			master.addEventListener('click', () => openMasterEditor(deps, view, pokemon, drawer));
			actions.append(master);
		}
		drawer.append(actions);
		return drawer;
	}
	async function render(deps) {
		const root = el('div', 'box-manager');
		try {
			const [view, backgrounds] = await Promise.all([loadView(deps), catalog()]);
			if (!view.boxes.some(box => box.index === ui.index)) ui.index = view.boxes[0]?.index || 0;
			root.append(teamPanel(deps, view), toolbar(deps), tabs(deps, view));
			const workspace = el('div', 'box-workspace');
			workspace.append(boxGrid(deps, view, backgrounds));
			const selected = allPokemon(view).find(pokemon => pokemon.pokemonId === ui.selectedId);
			if (selected) workspace.append(details(deps, view, selected));
			root.append(workspace);
		} catch (error) {
			root.append(el('div', 'panel empty-state', error.message));
		}
		return root;
	}
	window.RPGBoxUI = Object.freeze({ render });
})();